{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cited dispositions for source-derived visual obligations",
  "type": "object",
  "required": ["pages"],
  "properties": {
    "pages": {"type": "object", "additionalProperties": {
      "type": "object", "required": ["obligations"],
      "properties": {"obligations": {"type": "array", "items": {
        "type": "object", "required": ["id", "disposition", "source_refs"],
        "properties": {
          "id": {"type": "string"},
          "disposition": {"enum": ["resolved", "script_resolved", "preview_policy", "deferred", "not_applicable"]},
          "owner": {"type": "string"},
          "policy_ref": {"type": "string"},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["file", "line"],
            "properties": {"file": {"type": "string"}, "line": {"type": "integer", "minimum": 1}}}},
          "interpretation": {"type": "string"},
          "preview_value": {}
        }
      }}}
    }}
  }
}
