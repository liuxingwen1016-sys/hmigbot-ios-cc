{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime references for one canonical snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "path_base",
    "page_id",
    "source_activity",
    "runs",
    "states",
    "host_bindings",
    "zero_mapping"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "path_base": {
      "const": "spec"
    },
    "page_id": {
      "type": "string",
      "pattern": "^page_[A-Za-z0-9_.-]+$"
    },
    "source_activity": {
      "type": "string",
      "minLength": 3
    },
    "runs": {
      "type": "array"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "state_id",
          "review",
          "frames"
        ],
        "properties": {
          "state_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "review": {
            "type": "string",
            "minLength": 1
          },
          "frames": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "host_bindings": {
      "type": "array"
    },
    "state_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state_id", "status", "reason", "source_refs"]
      }
    },
    "zero_mapping": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
